{
	"name": "@ruah-dev/opt",
	"version": "0.1.1",
	"description": "Agent cost and token analytics \u2014 profile spend before optimizing it.",
	"type": "module",
	"ruah": {
		"namespace": "opt",
		"description": "Agent cost and token analytics \u2014 profile spend before optimizing it"
	},
	"bin": {
		"ruah-opt": "./bin/ruah-opt.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist/",
		"bin/",
		"scripts/",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"postinstall": "node ./scripts/ensure-ruah.mjs",
		"build": "tsc && chmod +x dist/cli.js",
		"dev": "tsc --watch",
		"typecheck": "tsc --noEmit",
		"lint": "biome check . --config-path ./biome.json",
		"format": "biome check --write . --config-path ./biome.json",
		"pretest": "tsc -p tsconfig.test.json",
		"test": "node --test dist-test/test/*.test.js",
		"clean": "rm -rf dist dist-test",
		"verify": "npm run lint && npm test && npm run build",
		"prepublishOnly": "npm run clean && npm run build && npm test"
	},
	"keywords": [
		"ai",
		"agents",
		"ruah",
		"tokens",
		"cost",
		"analytics",
		"profiler",
		"llm",
		"traces",
		"optimizer",
		"multi-agent"
	],
	"author": "ruah-dev",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ruah-dev/ruah-opt.git"
	},
	"bugs": {
		"url": "https://github.com/ruah-dev/ruah-opt/issues"
	},
	"homepage": "https://ruah.sh",
	"engines": {
		"node": ">=18.0.0"
	},
	"dependencies": {
		"@ruah-dev/cli": "github:ruah-dev/ruah-cli#v1.2.2"
	},
	"peerDependencies": {
		"@ruah-dev/schema": "^0.1.0"
	},
	"peerDependenciesMeta": {
		"@ruah-dev/schema": {
			"optional": false
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.10",
		"@ruah-dev/schema": "file:../ruah-schema",
		"@types/node": "^25.5.2",
		"typescript": "^6.0.2"
	}
}
